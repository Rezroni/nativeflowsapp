# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Providers (at least one required)
# OpenAI (GPT-4 Vision)
OPENAI_API_KEY=sk-proj-...
OPENAI_ORGANIZATION=org-... # Optional, only if your API key is tied to an organization

# Anthropic (Claude AI with Vision) - Fallback if OpenAI fails
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenRouter (Free Model for Free Trial Users)
OPENROUTER_API_KEY=sk-or-v1-...

# NOWPayments (Cryptocurrency Payment Processor)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_API_URL=http://localhost:3005/api

# Analytics (Optional)
# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Error Tracking (Optional)
# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Rate Limiting (Optional - for production with Redis)
UPSTASH_REDIS_REST_URL=...
UPSTASH_REDIS_REST_TOKEN=...
